# systemd user timer: run tesla-nightly-lock.service at 22:00 New York time,
# across daylight saving changes. Check with:
#   systemd-analyze calendar '*-*-* 22:00:00 America/New_York'
[Unit]
Description=Lock the Tesla every night at 22:00 America/New_York

[Timer]
OnCalendar=*-*-* 22:00:00 America/New_York
AccuracySec=1s
# If the host was off or asleep at 22:00, lock as soon as it is back.
Persistent=true

[Install]
WantedBy=timers.target
