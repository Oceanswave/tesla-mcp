# systemd user service: lock the car once through tesla-mcp.
# Install: see README.md in this directory. Started by tesla-nightly-lock.timer.
[Unit]
Description=Lock the Tesla through tesla-mcp and confirm it reports locked
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The MCP endpoint. The bearer token is read from ~/.tesla-mcp-bearer.
Environment=TESLA_MCP_URL=https://tesla-mcp.baristalabs.io/mcp
# Optional, when the account has more than one car:
#Environment=TESLA_VEHICLE_ID=
# Use the absolute path from `command -v node` (Node 22 or newer).
ExecStart=/usr/bin/node %h/tesla-mcp/scripts/nightly-lock/lock-car.mjs
# The server stops starting new attempts after 7 minutes; the script waits up to 10.
TimeoutStartSec=12min
