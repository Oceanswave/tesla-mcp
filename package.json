{
  "name": "tesla-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-operated MCP server on Cloudflare Workers that signs Tesla vehicle commands.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "@modelcontextprotocol/client": "2.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "@cloudflare/vitest-plugin": {
      "wrangler": "$wrangler"
    }
  }
}
