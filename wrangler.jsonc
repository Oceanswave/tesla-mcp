{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // No routes or custom domain in the repo: attach your own domain at deploy
  // time (Tesla requires the public key on a domain you own).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      // One OwnerState per owner: encrypted Tesla tokens, audit log, and the
      // serialized vehicle-command lane.
      { "name": "OWNER", "class_name": "OwnerState" },
      // One TeslaVcpSession per VIN: Vehicle Command Protocol sessions keyed
      // by (VIN, domain). Session keys live in memory only.
      { "name": "TESLA_VCP", "class_name": "TeslaVcpSession" }
    ]
  },
  // OAuth front door for /mcp: client registrations, hashed tokens, one-time
  // approval tokens, and failed-passphrase counters. Create it with
  // `npx wrangler kv namespace create OAUTH_KV` and put its id here.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "c207bed74c1c401cbff966048a4d4aaf" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerState", "TeslaVcpSession"] }],
  // Non-secret configuration. Secrets are listed in .dev.vars.example and set
  // with `wrangler secret put`.
  "vars": {
    "TESLA_FLEET_BASE_URL": "https://fleet-api.prd.na.vn.cloud.tesla.com",
    "TESLA_AUTH_TOKEN_URL": "https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token",
    // Public by definition: Tesla fetches it from
    // /.well-known/appspecific/com.tesla.3p.public-key.pem.
    "TESLA_PUBLIC_KEY_PEM": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEzU4sPRPe2N2yXYwhSgMjPAVW6Voq\nfHxe3wguACnHbh7buD93WNbnVSvCcPyCBtYRoj3m4MEoOlKtMah7cKH2OQ==\n-----END PUBLIC KEY-----\n",
    "DANGEROUS_COMMANDS_ENABLED": "true",
    // Where Tesla sends the browser after sign-in: /login and /callback use
    // `${OAUTH_REDIRECT_BASE}/callback`, which must be registered in the
    // developer app. Never derived from the request host.
    "OAUTH_REDIRECT_BASE": "https://tesla-mcp.sean-1b3.workers.dev",
    // The car tools use when called without vehicle_id: a VIN or Fleet vehicle
    // id. Empty: the account's only car (more than one car needs vehicle_id).
    "DEFAULT_VIN": "7G2CEHED3RA011124",
    // Extra OAuth redirect URIs, comma separated, beyond the built-in Claude
    // callbacks and http://localhost / http://127.0.0.1 on any port.
    "OAUTH_EXTRA_REDIRECT_URIS": "https://www.cursor.com/agents/mcp/oauth/callback"
  }
}
