{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // No routes or custom domain in the repo. The owner's deployment attaches
  // tesla-mcp.baristalabs.io as a custom domain at deploy time; self-hosters
  // use their own domain (Tesla requires the public key on a domain you own).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      // One OwnerState per owner: encrypted Tesla tokens, audit log, the
      // serialized vehicle-command lane, and the deprecated nightly alarm.
      { "name": "OWNER", "class_name": "OwnerState" },
      // One TeslaVcpSession per VIN: Vehicle Command Protocol sessions keyed
      // by (VIN, domain). Session keys live in memory only.
      { "name": "TESLA_VCP", "class_name": "TeslaVcpSession" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerState", "TeslaVcpSession"] }],
  "triggers": {
    // Deprecated with the built-in nightly lock: the cron only re-arms the
    // OwnerState alarm (idempotent). Removed together with the alarm.
    "crons": ["*/15 * * * *"]
  },
  // Non-secret configuration. Secrets are listed in .dev.vars.example and set
  // with `wrangler secret put`.
  "vars": {
    "TESLA_FLEET_BASE_URL": "https://fleet-api.prd.na.vn.cloud.tesla.com",
    "TESLA_AUTH_TOKEN_URL": "https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token",
    // Public by definition: Tesla fetches it from
    // /.well-known/appspecific/com.tesla.3p.public-key.pem.
    "TESLA_PUBLIC_KEY_PEM": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEzU4sPRPe2N2yXYwhSgMjPAVW6Voq\nfHxe3wguACnHbh7buD93WNbnVSvCcPyCBtYRoj3m4MEoOlKtMah7cKH2OQ==\n-----END PUBLIC KEY-----\n",
    // Deprecated built-in nightly lock. Still on so the car keeps locking
    // while the outside caller (scripts/nightly-lock/) proves itself; set to
    // "false" to hand over, then the alarm and these three vars are removed.
    "NIGHTLY_LOCK_ENABLED": "true",
    "NIGHTLY_LOCK_TIME": "22:00",
    "NIGHTLY_LOCK_TIMEZONE": "America/New_York",
    "DANGEROUS_COMMANDS_ENABLED": "false"
  }
}
