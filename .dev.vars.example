# Local development secrets for `wrangler dev`. Copy to .dev.vars (gitignored)
# and fill in. In production set each with `wrangler secret put NAME`.
# Every value below is a placeholder.

# Static bearer token MCP clients send as "Authorization: Bearer <token>". It
# also guards the /admin/clients API.
# Generate: openssl rand -base64 32
MCP_BEARER_TOKEN=replace-with-a-long-random-string

# Tesla developer application credentials (developer.tesla.com).
TESLA_CLIENT_ID=replace-with-your-client-id
TESLA_CLIENT_SECRET=replace-with-your-client-secret

# The vehicle-command private key: base64 of the PKCS#8 DER encoding of your
# P-256 key. It must match TESLA_PUBLIC_KEY_PEM in wrangler.jsonc.
# Convert without writing a file:
#   openssl pkcs8 -topk8 -nocrypt -in private-key.pem -outform DER | base64 | tr -d '\n'
TESLA_COMMAND_PRIVATE_KEY_PKCS8_B64=replace-with-base64-pkcs8-der

# AES-256-GCM key for Tesla tokens at rest: base64 of 32 random bytes.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes

# Optional: a Tesla refresh token for your account, as an alternative to
# signing in at /login. Seeded into the encrypted token store once per distinct
# value: setting a new value also signs in again after reauth_required. The
# same value is never seeded twice, and a browser sign-in supersedes it.
TESLA_BOOTSTRAP_REFRESH_TOKEN=replace-with-a-refresh-token

# Passphrase the owner types on /authorize to approve an OAuth MCP client
# (Claude's connector, or a static client from /admin/clients). Unset: every
# authorization is refused. Generate: openssl rand -base64 24
OAUTH_ADMIN_PASSPHRASE=replace-with-a-long-random-passphrase

# Optional: a webhook told about each audited command. Unset: no notifications.
NOTIFY_URL=https://example.com/replace-with-your-webhook
# The full Authorization header value the webhook expects, scheme included.
NOTIFY_AUTH=replace-with-the-full-authorization-header-value
